{
  "compatibility_date": "2026-08-29",
  "main": "src/bet-worker.ts",
  "name": "cloudbet-bet-worker",
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "TRACKER",
      "service": "goal-watch-tracker"
    },
    {
      "binding": "MATCHER",
      "service": "cloudbet-match-matcher"
    },
    {
      "binding": "CLOUDBET",
      "service": "cloudbetapi"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "379c05b1-2779-4c26-b07e-f6cf05675d62",
      "database_name": "d1-template-database"
    }
  ]
}
