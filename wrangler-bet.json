{
  "compatibility_date": "2026-08-29",
  "main": "src/bet-worker.ts",
  "name": "cloudbet-bet-worker",
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "TRACKER",
      "service": "goal-watch-tracker"
    },
    {
      "binding": "MATCHER",
      "service": "cloudbet-match-matcher"
    },
    {
      "binding": "CLOUDBET",
      "service": "cloudbetapi"
    }
  ]
}
